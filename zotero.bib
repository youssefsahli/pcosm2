	pmcid = {PMC1313538},
	keywords = {Administration, Oral, Administration, Topical, Aloe, Anti-Infective Agents, Anti-Inflammatory Agents, Complementary Therapies, Controlled Clinical Trials as Topic, Diabetes Mellitus, Female, Herpes Genitalis, Humans, Hyperlipidemias, Hypoglycemic Agents, Male, Phytotherapy, Plants, Medicinal, Psoriasis},
}

