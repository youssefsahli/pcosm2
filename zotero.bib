	journaltitle = {Separations},
	author = {Khuranna, Deepak and Sharma, Sanchit and Mir, Showkat Rasool and Aqil, Mohd and Ahmad, Ajaz and Rehman, Muneeb U. and Ahmad, Parvaiz and Alwahibi, Mona S. and Elshikh, Mohamed Soliman and Mujeeb, Mohd},
	urldate = {2025-10-04},
