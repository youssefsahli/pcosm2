	author = {{Frederico Pittella} and Pittella, Frederico and {Rafael C. Dutra} and {Rafael C. Dutra} and Dutra, Rafael C. and {David A. Dalton} and Júnior, Dalton Dittz and {Míriam Teresa Paz Lopes} and Lopes, Miriam T. P. and {Nádia R. Barbosa} and Barbosa, Nádia R.},
