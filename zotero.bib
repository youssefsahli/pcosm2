@incollection{kumar_chapter_2024,
	title = {Chapter 20 - Dermatological formulations},
	isbn = {978-0-323-91817-6},
	url = {https://www.sciencedirect.com/science/article/pii/B9780323918176000218},
	abstract = {Dermatology is the study, investigation, diagnosis, and management of any health disease affecting the skin, hair, nails, and membranes. The conditions of the hair, skin, or nails are very common and almost everyone experiences symptoms of one or other dermatologic condition at some point in their life. Some of the most common dermatologic conditions include acne, wrinkles, cold sores, dermatitis, and others. To treat these conditions, various dermatological formulations are utilized which involve gels, creams, powders, aerosols, and transdermal patches. The transdermal drug delivery systems have several advantages. It can avoid first-pass metabolism and maintain plasma drug concentration for a prolonged time, requiring less dose to be administered. Furthermore, it decreases {GIT} side or unwanted effects, and one can remove the formulation in case of toxic effects and increase patient compliance. On the other hand, the administration of medications via these methods increases the risk of skin irritation at the site of delivery, which is one of the possible adverse effects. Skin irritation reactions include allergic contact dermatitis, which is a delayed, T-cell-mediated inflammatory response to a specific allergen, and irritant contact dermatitis ({ICD}), which is an inflammatory response caused by repeated or direct skin exposure to weak irritants. Both of these types of dermatitis are known as {ICD}. In this chapter, we discussed various dermatological formulations, manufacturing challenges and methods to overcome these challenges. This book chapter also discusses the various evaluation parameters used for dermatological products.},
	pages = {613--642},
	booktitle = {Dosage Forms, Formulation Developments and Regulations},
	publisher = {Academic Press},
	author = {Kumar, Mohit and Mandal, Uttam Kumar and Mahmood, Syed},
	editor = {Nayak, Amit Kumar and Sen, Kalyan Kumar},
	urldate = {2025-05-12},
	date = {2024-01-01},
	doi = {10.1016/B978-0-323-91817-6.00021-8},
	keywords = {Dermatological products, dermatological challenges, skin irritation, skincare, transdermal drug delivery},
}

