@article{ait-touchente_exploring_2023,
	title = {Exploring the Versatility of Microemulsions in Cutaneous Drug Delivery: Opportunities and Challenges},
	volume = {13},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2079-4991},
