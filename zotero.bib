@article{adarsh_krishna_bakuchiol_2022,
	title = {Bakuchiol – a natural meroterpenoid: structure, isolation, synthesis and functionalization approaches},
	volume = {12},
	issn = {2046-2069},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC8985110/},
