}

@article{rackova_mechanism_2007,
	title = {Mechanism of anti-inflammatory action of liquorice extract and glycyrrhizin},
	volume = {21},
	issn = {1478-6419},
	doi = {10.1080/14786410701371280},
	abstract = {The antiradical activity, protective effect against lipid peroxidation of liposomal membrane, and inhibitory effect on whole blood reactive oxygen species ({ROS}) liberation of Glycyrrhiza glabra crude extract and glycyrrhizin, its major compound, were assessed. The liquorice extract showed significant activity in all the three assay systems used in a dose dependent manner. It displayed remarkable reactivity with free stable 1,1'-diphenyl-2-picrylhydrazyl ({DPPH}) radical, inhibitory efficacy in peroxidatively damaged unilamellar dioleoyl phosphatidylcholine ({DOPC}) liposomes, and inhibition of {ROS} chemiluminescence, generated by whole blood, induced by both receptor-bypassing stimuli ({PMA}) and receptor operating stimuli (Opz) in the ranking order of stimuli {PMA}{\textgreater} Opz. These activities may be attributed to phenolic antioxidants involving isoflavan derivatives, coumarins and chalcones. Nonetheless, triterpene saponin glycyrrhizin exhibited no efficacy in the system of {DPPH} reaction and peroxidation of liposomal membrane, and negligible inhibition of chemiluminescence generated by inflammatory cells. These results indicate that the mechanism of anti-inflammatory effect of glycyrrhizin most probably does not involve {ROS} and this major constituent is not responsible for the inhibition effects of liquorice extract on neutrophil functions.},
	pages = {1234--1241},
	number = {14},
	journaltitle = {Natural Product Research},
	shortjournal = {Nat Prod Res},
	author = {Racková, Lucia and Jancinová, Viera and Petríková, Margita and Drábiková, Katarína and Nosál, Radomír and Stefek, Milan and Kostálová, Daniela and Prónayová, Nada and Kovácová, Mária},
	date = {2007-12},
	pmid = {18075885},
	keywords = {Anti-Inflammatory Agents, Biphenyl Compounds, Flavonoids, Free Radicals, Glycyrrhiza, Glycyrrhizic Acid, Hydrazines, Lipid Peroxidation, Luminescence, Molecular Structure, Oxidation-Reduction, Phenols, Picrates, Plant Extracts, Polyphenols, Reactive Oxygen Species},
}

