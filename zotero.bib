	langid = {english},
	keywords = {Exposure assessment, Mathematical, Model, Permeability, Stratum corneum, Theory, Transdermal},
}

@article{manicone_matrix_2008,
	title = {Matrix Metalloproteinases as Modulators of Inflammation},
