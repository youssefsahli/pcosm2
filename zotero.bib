@article{saha_performance_2005,
	title = {{PERFORMANCE} {OF} {ALOE} {VERA} {AS} {INFLUENCED} {BY} {ORGANIC} {AND} {INORGANIC} {SOURCES} {OF} {FERTILIZER} {SUPPLIED} {THROUGH} {FERTIGATION}},
