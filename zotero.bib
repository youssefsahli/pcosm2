@incollection{javed_aloe_2014,
	title = {\textit{Aloe Vera} Gel in Food, Health Products, and Cosmetics Industry},
	volume = {41},
	url = {https://www.sciencedirect.com/science/article/pii/B9780444632944000097},
	abstract = {Aloe vera has found wide applications in the cosmetics and nutraceutical industry. The plant material is used as fundamental ingredient in food and cosmetics products after processing in the form of gel and juice. Aloe gel contains mannose polymers with various sugars including glucose; acemannan is the most active ingredient. Other ingredients such as vitamins, minerals, enzymes, proteins, and phytosterols are also present. The mode of action of the active ingredients is discussed with their medicinal and cosmetic effects. The therapeutic potential of Aloe gel with special emphasis on oral and topical use for antidiabetic, heart disease management, anticancer, anti-inflammatory, antioxidant, immunomodulatory, antiulcer, hepatoprotective, gastrointestinal, antiarthritic, dentistry, burns and wound healing, skin hydration, skin protection from {UV} and gamma radiation and psoriasis has been reviewed. This chapter summarizes the chemistry, processing techniques, and medicinal uses of Aloe vera products.},
	pages = {261--285},
	booktitle = {Studies in Natural Products Chemistry},
	publisher = {Elsevier},
	author = {Javed, Shabnam and {Atta-ur-Rahman}},
	editor = {{Atta-ur-Rahman}},
	urldate = {2025-10-02},
	date = {2014-01-01},
	doi = {10.1016/B978-0-444-63294-4.00009-7},
	keywords = {Bioactive compounds, Food and cosmetics uses, Processing, Quality control, Therapeutic properties, gel},
}

@article{baruah_aloe_2016,
	title = {\textit{Aloe vera}: A multipurpose industrial crop},
	volume = {94},
	issn = {0926-6690},
	url = {https://www.sciencedirect.com/science/article/pii/S0926669016305477},
	doi = {10.1016/j.indcrop.2016.08.034},
	shorttitle = {\textit{Aloe vera}},
	abstract = {Aloe vera is a well known medicinal plant which thrives in varied agro-climates. It was native to Northern Africa, but now it is widely distributed throughout the world. The chemistry of the plant reveals the presence of diverse biologically active compounds associated with curing different ailments such as wound, inflammations, cancer, diabetes, ulcer, microbial diseases, skin diseases, acquired immune deficiency syndrome ({AIDS}), liver problems, dental problems, cardiovascular problems, hyperlipidmia and others. The plant also shows anti-aging, laxative, antioxidant and immunomodulatory activities. Most of the biological activities are contributed by the wide varieties of compounds present in the sap and gel of A. vera. Various scientific investigations have proved that anthraquinones and glycosides present in the sap of A. vera are responsible for minimizing the severity of cancer, free radicals activity, diabetes, inflammation, microbial diseases, tyrosinase activity, spermatogenic activity, β-secretase inhibitory activity and proliferative activity. It also affects estrogen status and intestinal absorption of the cell along with laxative activities. In addition to the therapeutic properties, the gel is used as an important ingredient of various cosmetic formulations. Though few reports have cited the side effects of anthraquinones, but it is negligible compared to its medicinal properties. This review article also describes about the various factors affecting the chemical composition of A. vera such as different existing varieties of A. vera, annual season rainfall, temperature, incident solar radiation, harvest date, climate, land and cultivation methods. In view of high interest shown by the people of different countries for its medicinal value and commercial uses, it is quite worthy to review the active constituents and clinical effectiveness of A. vera.},
	pages = {951--963},
	journaltitle = {Industrial Crops and Products},
	shortjournal = {Industrial Crops and Products},
	author = {Baruah, Adrisyanti and Bordoloi, Manobjyoti and Deka Baruah, Hari Prasanna},
	urldate = {2025-09-22},
	date = {2016-12-30},
	keywords = {Alloeh, Aloe emodin, Aloe gel, Aloin, Biological activities},
}

@incollection{xiaoying_glycyrrhiza_2017,
	title = {\textit{Glycyrrhiza glabra} (Licorice)},
	isbn = {978-0-12-805413-0},
	url = {https://www.sciencedirect.com/science/article/pii/B9780128054130000144},
	abstract = {The licorice (Radix Glycyrrhizae or Liquiritiae radix), which is broadly used in medicine and commerce, is derived from the sweet root of various species of Glycyrrhiza (Glycyrrhiza uralensis Fisch., Glycyrrhiza glabra L., or Glycyrrhiza inflata Bat., Leguminosae). Licorice is native to southern Europe and parts of Asia; it is one of the most commonly used herbal medicines and an important source of confectionery (Fiore et al., 2005). Therefore the health properties associated with licorice are well documented. According to the World Health Organization, licorice is employed as a demulcent in the treatment of sore throats and an expectorant for coughs and bronchial catarrh. Licorice also has a critical role in the prophylaxis and treatment of gastric and duodenal ulcers as well as dyspepsia. As an antiinflammatory agent, licorice reduces allergic reactions and prevents liver toxicity. In China, licorice is also documented to be effective for fatigue and debilitation (China, 2015). In this chapter, active components, extractions or preparations of liquorice in the medical use included protection of the nervous, endocrine, respiratory, digestive and cardiovascular systems that are supported by experimental or clinical data will be summarized.},
	pages = {231--250},
	booktitle = {Sustained Energy for Enhanced Human Functions and Activity},
	publisher = {Academic Press},
	author = {Xiaoying, Wang and Han, Zhang and Yu, Wang},
	editor = {Bagchi, Debasis},
	urldate = {2025-04-20},
	date = {2017-01-01},
	doi = {10.1016/B978-0-12-805413-0.00014-4},
	keywords = {Airway protection, Ethnobotany, Glycyrrhizin, Hepatoprotective effect, Immunity regulation, Licorice},
}

